<resources>
    <!-- Theme.Holo straight from the framework, works on api 11+ and still ships on current android -->
    <style name="ZenlessTheme" parent="@android:style/Theme.Holo.NoActionBar">
        <item name="android:windowBackground">@color/holo_bg</item>
        <item name="android:colorBackground">@color/holo_bg</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:windowFullscreen">true</item>
    </style>

    <style name="HoloTab">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">center</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:background">@drawable/holo_tab_bg</item>
    </style>

    <style name="HoloButton" parent="@android:style/Widget.Holo.Button">
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="MenuButton">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">56dp</item>
        <item name="android:layout_marginBottom">12dp</item>
        <item name="android:background">@drawable/holo_button_bg</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">18sp</item>
        <item name="android:fontFamily">sans-serif-light</item>
    </style>
</resources>

<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <solid android:color="#6633B5E5" />
            <stroke android:width="2dp" android:color="@color/holo_blue" />
        </shape>
    </item>
    <item android:state_enabled="false">
        <shape>
            <solid android:color="#FF151515" />
            <stroke android:width="1dp" android:color="@color/holo_divider" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="#CC101820" />
            <stroke android:width="1dp" android:color="@color/holo_blue_dark" />
        </shape>
    </item>
</selector>
